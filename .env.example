# 复制为 .env 并按需填写（本项目直接读环境变量，不自动加载 .env，
# 请用 shell export 或进程管理器的环境配置注入）。

# 必填：JWT 签名密钥。不设置则每次启动随机生成，重启后 JWT 失效。
SECRET_KEY=

# 可选：Tushare Pro token。不配置则市值/涨跌幅/K线字段留空。
TUSHARE_TOKEN=

# 可选：股票基础库（只读），等价于 config/mysql.json
STOCK_DB_HOST=
STOCK_DB_PORT=3306
STOCK_DB_USER=
STOCK_DB_PASSWORD=
STOCK_DB_NAME=stock_db_daily

# 可选：研究记录板同步库，等价于 config/mysql_sync.json
MYSQL_HOST=
MYSQL_PORT=3306
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_DB=

# 调试：置 1 则 import/启动时不拉起后台线程
QMT_DASHBOARD_SKIP_BACKGROUND_TASKS=
